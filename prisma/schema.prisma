// ============================================================================
// Campus Connect — Prisma Schema
// Multi-tenant OD Management Platform
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  SUPER_ADMIN
  HOD
  STAFF
  STUDENT
}

enum StaffBatchRoleType {
  TUTOR
  SUBJECT_TEACHER
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimetableSlotType {
  SUBJECT
  BREAK
  LUNCH
}

enum OdStatus {
  PENDING_TUTOR
  REJECTED_BY_TUTOR
  PENDING_HOD
  REJECTED_BY_HOD
  APPROVED
}

enum OdApprovalStatus {
  APPROVED
  REJECTED
}

enum ApprovalRole {
  TUTOR
  HOD
}

// ============================================================================
// Models
// ============================================================================

model College {
  id           String   @id @default(uuid())
  name         String
  emailAddress String   @map("email_address")
  collegeCode  String   @unique @map("college_code")
  city         String
  state        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  departments   Department[]
  users         User[]
  batches       Batch[]
  subjects      Subject[]
  students      Student[]
  notifications Notification[]
  odRequests    OdRequest[]
  hackathons    Hackathon[]
  events        Event[]

  @@map("colleges")
}

model Department {
  id        String @id @default(uuid())
  collegeId String @map("college_id")
  name      String

  // Relations
  college    College     @relation(fields: [collegeId], references: [id])
  users      User[]
  batches    Batch[]
  subjects   Subject[]
  hackathons Hackathon[]
  events     Event[]

  @@index([collegeId])
  @@map("departments")
}

model User {
  id                 String   @id @default(uuid())
  collegeId          String?  @map("college_id")
  name               String
  email              String
  password           String
  role               Role
  isTutor            Boolean  @default(false) @map("is_tutor")
  departmentId       String?  @map("department_id")
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  profileImageUrl    String?  @map("profile_image_url")
  phoneNumber        String?  @map("phone_number")
  bio                String?
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  college            College?            @relation(fields: [collegeId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  student            Student?
  staffBatchMappings StaffBatchMapping[]
  subjectAssignments SubjectAssignment[]
  tutorBatches       Batch[]             @relation("BatchTutor")
  odApprovals        OdApproval[]
  notifications      Notification[]
  timetableSlots     Timetable[]
  createdHackathons  Hackathon[]         @relation("HackathonCreator")
  createdEvents      Event[]             @relation("EventCreator")

  @@unique([collegeId, email])
  @@index([collegeId])
  @@index([departmentId])
  @@map("users")
}

model Student {
  id             String @id @default(uuid())
  userId         String @unique @map("user_id")
  collegeId      String @map("college_id")
  registerNumber String @map("register_number")
  batchId        String @map("batch_id")

  // Relations
  user                    User                  @relation(fields: [userId], references: [id])
  college                 College               @relation(fields: [collegeId], references: [id])
  batch                   Batch                 @relation(fields: [batchId], references: [id])
  odRequests              OdRequest[]
  odParticipations        OdParticipant[]
  ledHackathonTeams       HackathonTeam[]       @relation("TeamLeader")
  hackathonParticipations HackathonTeamMember[]

  @@unique([collegeId, registerNumber])
  @@index([collegeId])
  @@index([batchId])
  @@map("students")
}

model Batch {
  id              String  @id @default(uuid())
  collegeId       String  @map("college_id")
  departmentId    String  @map("department_id")
  name            String
  tutorId         String? @map("tutor_id")
  startYear       Int     @map("start_year")
  endYear         Int     @map("end_year")
  currentSemester Int     @default(1) @map("current_semester")
  isPassedOut     Boolean @default(false) @map("is_passed_out")

  // Relations
  college            College             @relation(fields: [collegeId], references: [id])
  department         Department          @relation(fields: [departmentId], references: [id])
  tutor              User?               @relation("BatchTutor", fields: [tutorId], references: [id])
  students           Student[]
  staffBatchMappings StaffBatchMapping[]
  subjectAssignments SubjectAssignment[]
  timetableSlots     Timetable[]
  odRequests         OdRequest[]

  @@index([collegeId])
  @@index([departmentId])
  @@map("batches")
}

model StaffBatchMapping {
  id       String             @id @default(uuid())
  staffId  String             @map("staff_id")
  batchId  String             @map("batch_id")
  roleType StaffBatchRoleType @map("role_type")

  // Relations
  staff User  @relation(fields: [staffId], references: [id])
  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([staffId, batchId, roleType])
  @@index([staffId])
  @@index([batchId])
  @@map("staff_batch_mappings")
}

model Subject {
  id           String @id @default(uuid())
  collegeId    String @map("college_id")
  name         String
  subjectCode  String @map("subject_code")
  departmentId String @map("department_id")
  semester     Int

  // Relations
  college        College             @relation(fields: [collegeId], references: [id])
  department     Department          @relation(fields: [departmentId], references: [id])
  assignments    SubjectAssignment[]
  timetableSlots Timetable[]

  @@unique([collegeId, subjectCode])
  @@index([collegeId])
  @@map("subjects")
}

model SubjectAssignment {
  id        String @id @default(uuid())
  subjectId String @map("subject_id")
  batchId   String @map("batch_id")
  staffId   String @map("staff_id")

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])
  staff   User    @relation(fields: [staffId], references: [id])

  @@unique([subjectId, batchId])
  @@index([batchId])
  @@index([staffId])
  @@map("subject_assignments")
}

model Timetable {
  id        String            @id @default(uuid())
  batchId   String            @map("batch_id")
  semester  Int               @default(1)
  day       Day
  startTime String            @map("start_time")
  endTime   String            @map("end_time")
  type      TimetableSlotType
  subjectId String?           @map("subject_id")
  staffId   String?           @map("staff_id")

  // Relations
  batch   Batch    @relation(fields: [batchId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])
  staff   User?    @relation(fields: [staffId], references: [id])

  @@index([batchId])
  @@map("timetables")
}

model OdRequest {
  id           String       @id @default(uuid())
  studentId    String       @map("student_id")
  batchId      String       @map("batch_id")
  collegeId    String       @map("college_id")
  subject      String
  description  String
  isGroup      Boolean      @default(false) @map("is_group")
  startDate    DateTime     @default(now()) @map("start_date")
  endDate      DateTime     @default(now()) @map("end_date")
  status       OdStatus     @default(PENDING_TUTOR)
  currentLevel ApprovalRole @default(TUTOR) @map("current_level")
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relations
  student      Student         @relation(fields: [studentId], references: [id])
  batch        Batch           @relation(fields: [batchId], references: [id])
  college      College         @relation(fields: [collegeId], references: [id])
  approvals    OdApproval[]
  participants OdParticipant[]

  @@index([studentId])
  @@index([batchId])
  @@index([status])
  @@index([collegeId])
  @@map("od_requests")
}

model OdParticipant {
  id          String @id @default(uuid())
  odRequestId String @map("od_request_id")
  studentId   String @map("student_id")

  // Relations
  odRequest OdRequest @relation(fields: [odRequestId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id])

  @@unique([odRequestId, studentId])
  @@index([studentId])
  @@map("od_participants")
}

model OdApproval {
  id          String           @id @default(uuid())
  odRequestId String           @map("od_request_id")
  approvedBy  String           @map("approved_by")
  role        ApprovalRole
  status      OdApprovalStatus
  remark      String?
  timestamp   DateTime         @default(now())

  // Relations
  odRequest OdRequest @relation(fields: [odRequestId], references: [id])
  approver  User      @relation(fields: [approvedBy], references: [id])

  @@index([odRequestId])
  @@map("od_approvals")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  collegeId String   @map("college_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  college College @relation(fields: [collegeId], references: [id])

  @@index([userId])
  @@index([collegeId])
  @@map("notifications")
}

// ============================================================================
// Hackathon Models
// ============================================================================

model Hackathon {
  id                   String   @id @default(uuid())
  collegeId            String   @map("college_id")
  departmentId         String   @map("department_id")
  name                 String
  description          String
  isGroup              Boolean  @default(false) @map("is_group")
  minSize              Int?     @map("min_size")
  maxSize              Int?     @map("max_size")
  thumbnailUrl         String?  @map("thumbnail_url")
  registrationDeadline DateTime @map("registration_deadline")
  hackathonDate        DateTime @map("hackathon_date")
  createdById          String   @map("created_by_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  college    College         @relation(fields: [collegeId], references: [id])
  department Department      @relation(fields: [departmentId], references: [id])
  createdBy  User            @relation("HackathonCreator", fields: [createdById], references: [id])
  teams      HackathonTeam[]

  @@index([collegeId])
  @@index([departmentId])
  @@map("hackathons")
}

model HackathonTeam {
  id              String   @id @default(uuid())
  hackathonId     String   @map("hackathon_id")
  leaderId        String   @map("leader_id")
  teamName        String?  @map("team_name")
  ideaTitle       String   @map("idea_title")
  ideaDescription String   @map("idea_description")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  hackathon Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  leader    Student               @relation("TeamLeader", fields: [leaderId], references: [id])
  members   HackathonTeamMember[]
  progress  HackathonProgress[]

  @@index([hackathonId])
  @@index([leaderId])
  @@map("hackathon_teams")
}

model HackathonTeamMember {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  studentId   String   @map("student_id")
  hackathonId String   @map("hackathon_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  // Relations
  team    HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id])

  @@unique([hackathonId, studentId])
  @@index([teamId])
  @@index([studentId])
  @@map("hackathon_team_members")
}

model HackathonProgress {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  team HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("hackathon_progress")
}

model Event {
  id           String   @id @default(uuid())
  collegeId    String   @map("college_id")
  departmentId String   @map("department_id")
  name         String
  description  String
  thumbnailUrl String?  @map("thumbnail_url")
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  college    College    @relation(fields: [collegeId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  createdBy  User       @relation("EventCreator", fields: [createdById], references: [id])

  @@index([collegeId])
  @@index([departmentId])
  @@map("events")
}
